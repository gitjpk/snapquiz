# Database
DATABASE_URL="file:./dev.db"

# Demo mode (used by /api/dev/* endpoints for e2e testing)
DEMO_API_KEY="your-demo-api-key-here"

# LLM API Key Encryption (required for AI quiz generation)
# Generate with: openssl rand -hex 32
# Or PowerShell: [BitConverter]::ToString((1..32 | ForEach-Object { Get-Random -Max 256 })) -replace '-',''
LLM_KEY_ENCRYPTION_SECRET="your-32-byte-hex-secret-here"

# HTTPS cookies (set to "true" when using ngrok or in production)
# USE_HTTPS_COOKIES="true"

# Server configuration
PORT=3000
